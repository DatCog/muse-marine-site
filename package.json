{
  "name": "muse-marine-site",
  "version": "1.0.0",
  "private": true,
  "description": "MUSE MARINE company website",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./dist/assets/styles.css --minify",
    "build:html": "node build.mjs",
    "build": "node build.mjs && tailwindcss -i ./src/input.css -o ./dist/assets/styles.css --minify",
    "dev": "tailwindcss -i ./src/input.css -o ./dist/assets/styles.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
